<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/findBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="Find"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:gravity="center"
            android:textSize="12sp" />
        <TextView android:id="@+id/findPrev" style="@style/ExplorerAction" android:text="▲" />
        <TextView android:id="@+id/findNext" style="@style/ExplorerAction" android:text="▼" />
        <TextView android:id="@+id/findClose" style="@style/ExplorerAction" android:text="✕" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/replaceInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="Replace"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp" />
        <TextView android:id="@+id/replaceOne" style="@style/ExplorerAction" android:text="Replace" />
        <TextView android:id="@+id/replaceAll" style="@style/ExplorerAction" android:text="All" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <CheckBox
            android:id="@+id/findCase"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Match case"
            android:textSize="12sp" />
        <CheckBox
            android:id="@+id/findRegex"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Regex"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
